# ───────────────────────────────────────────────────────────
# SENTINEL — On-chain AI Policy Firewall on Mantle
# ───────────────────────────────────────────────────────────

# Mantle Sepolia testnet (chainId 5003). `npm run genkey` fills these in for you.
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003

# Deployer/relayer key — pays gas, deploys contracts, relays vault executions.
# Generated by `npm run genkey`. Fund it at https://faucet.sepolia.mantle.xyz
DEPLOYER_KEY=

# Policy-signer key — the AI policy oracle. Signs EIP-712 approvals. Needs no gas.
# Generated by `npm run genkey`.
POLICY_SIGNER_KEY=

# LLM provider for live policy evaluation (leave blank to use the deterministic
# simulation engine — the demo still runs fully without a key).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Alternatively, call Claude directly:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the dead-agent switch sweeps funds (defaults to a derived demo address).
BACKUP_WALLET=

PORT=3000
